{
  // Oxc: oxfmt formats, oxlint fixes on save. Both read the project configs.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "oxc.requireConfig": true,
  "eslint.enable": false,
  "prettier.enable": false,

  // Tailwind IntelliSense inside cn() and cva().
  "tailwindCSS.classFunctions": ["cn", "cva", "clsx"],

  // Generated by TanStack Router.
  "files.readonlyInclude": { "**/routeTree.gen.ts": true },
  "files.watcherExclude": { "**/routeTree.gen.ts": true },
  "search.exclude": { "**/routeTree.gen.ts": true }
}
