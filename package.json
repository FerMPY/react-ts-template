{
  "name": "react-ts-template",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:spa": "vite dev --mode spa",
    "build": "vite build",
    "build:spa": "vite build --mode spa",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "preview:spa": "vite preview --mode spa",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:react": "react-doctor . --verbose",
    "lint:unused": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "oxfmt --check && oxlint --deny-warnings && tsc --noEmit && knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.260903-beta",
    "oxc-transform-react": "~0.152.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react-doctor": "^0.9.18",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,mjs,cjs,ts,tsx,mts,cts})": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.10.1"
}
